generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum ExamDateSheetType {
  MANUAL
  PDF
}

enum ExamDateSheetStatus {
  DRAFT
  PUBLISHED
}

enum ResultTerm {
  TERM_1
  TERM_2
}

enum ResultStatus {
  DRAFT
  PUBLISHED
}

model academicclass {
  id        Int      @id @default(autoincrement())
  name      String
  schoolId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime

  school             school               @relation(fields: [schoolId], references: [id], map: "AcademicClass_schoolId_fkey")
  section            section[]
  calendareventclass calendareventclass[]
  classSubjects      classsubject[]
  examdatesheets     examdatesheet[]
  results result[]
  resultComponentConfigs resultcomponentconfig[]

  @@unique([schoolId, name], map: "AcademicClass_schoolId_name_key")
  @@index([schoolId], map: "AcademicClass_schoolId_idx")
}

model academicyear {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  name      String
  startDate DateTime
  endDate   DateTime
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime

  school         school           @relation(fields: [schoolId], references: [id], map: "AcademicYear_schoolId_fkey")
  schoolcalendar schoolcalendar[]
  calendarevent  calendarevent[]
  timetable      timetable[]
  homework       homework[]
  syllabi        syllabus[]
  examdatesheets examdatesheet[]
  results result[]
  resultComponentConfigs resultcomponentconfig[]

  @@unique([schoolId, name], map: "AcademicYear_schoolId_name_key")
  @@index([schoolId], map: "AcademicYear_schoolId_idx")
}

model attendance {
  id        Int      @id @default(autoincrement())
  studentId Int
  date      DateTime
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime

  student student @relation(fields: [studentId], references: [id], map: "Attendance_studentId_fkey")

  @@unique([studentId, date], map: "Attendance_studentId_date_key")
  @@index([studentId, date], map: "Attendance_studentId_date_idx")
}

model school {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique(map: "School_code_key")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime

  academicclass    academicclass[]
  academicyear     academicyear[]
  schoolcalendar   schoolcalendar[]
  student          student[]
  schoolworkingday schoolworkingday[]
  calendarevent    calendarevent[]
  schoolsaturday   schoolsaturday[]
  homework         homework[]
  subjects         schoolsubject[]
  examdatesheets   examdatesheet[]
  results result[]
  resultComponentConfigs resultcomponentconfig[]
}

model schoolcalendar {
  id             Int      @id @default(autoincrement())
  schoolId       Int
  date           DateTime
  title          String
  type           String
  status         String   @default("HOLIDAY")
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  academicYearId Int

  academicyear academicyear @relation(fields: [academicYearId], references: [id], map: "SchoolCalendar_academicYearId_fkey")
  school       school       @relation(fields: [schoolId], references: [id], map: "SchoolCalendar_schoolId_fkey")

  @@unique([schoolId, date], map: "SchoolCalendar_schoolId_date_key")
  @@index([academicYearId, date], map: "SchoolCalendar_academicYearId_date_idx")
  @@index([schoolId, date], map: "SchoolCalendar_schoolId_date_idx")
}

model section {
  id        Int      @id @default(autoincrement())
  name      String
  classId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime

  academicclass academicclass @relation(fields: [classId], references: [id], map: "Section_classId_fkey")
  student       student[]
  timetable     timetable[]
  homework      homework[]
  results result[]

  @@unique([classId, name], map: "Section_classId_name_key")
  @@index([classId], map: "Section_classId_idx")
}

model student {
  id              Int      @id @default(autoincrement())
  studentId       String   @unique(map: "Student_studentId_key")
  name            String
  email           String   @unique(map: "Student_email_key")
  phone           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  schoolId        Int?
  sectionId       Int?
  profileImageUrl String?

  results result[]
  attendance attendance[]
  school     school?      @relation(fields: [schoolId], references: [id], map: "Student_schoolId_fkey")
  section    section?     @relation(fields: [sectionId], references: [id], map: "Student_sectionId_fkey")
  user       user?

  @@index([schoolId], map: "Student_schoolId_idx")
  @@index([sectionId], map: "Student_sectionId_idx")
}

model user {
  id           Int      @id @default(autoincrement())
  loginId      String   @unique(map: "User_loginId_key")
  passwordHash String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  studentId    Int?     @unique(map: "User_studentId_key")

  student student? @relation(fields: [studentId], references: [id], map: "User_studentId_fkey")
}

model schoolworkingday {
  id              Int      @id @default(autoincrement())
  schoolId        Int
  dayOfWeek       Int
  isWorking       Boolean  @default(true)
  saturdayPattern String   @default("ALL_WORKING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  school school @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, dayOfWeek])
  @@index([schoolId])
}

model calendarevent {
  id             Int      @id @default(autoincrement())
  schoolId       Int
  academicYearId Int
  title          String
  type           String
  targetType     String   @default("ALL_CLASSES")
  createdAt      DateTime @default(now())
  updatedAt      DateTime

  school       school               @relation(fields: [schoolId], references: [id])
  academicyear academicyear         @relation(fields: [academicYearId], references: [id])
  dates        calendareventdate[]
  classes      calendareventclass[]

  @@index([schoolId])
  @@index([academicYearId])
}

model calendareventdate {
  id        Int      @id @default(autoincrement())
  eventId   Int
  date      DateTime
  createdAt DateTime @default(now())

  event calendarevent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, date])
  @@index([date])
}

model calendareventclass {
  eventId Int
  classId Int

  event         calendarevent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  academicclass academicclass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([eventId, classId])
  @@index([classId])
}

model schoolsaturday {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  date      DateTime
  isWorking Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime

  school school @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, date])
  @@index([schoolId, date])
}

model timetable {
  id             Int      @id @default(autoincrement())
  sectionId      Int
  academicYearId Int
  dayOfWeek      Int
  periodNumber   Int
  startTime      String
  endTime        String
  title          String
  type           String   @default("SUBJECT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  section      section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicyear academicyear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([sectionId, academicYearId, dayOfWeek, periodNumber])
  @@index([sectionId, academicYearId])
  @@index([academicYearId])
}

model homework {
  id             Int @id @default(autoincrement())
  schoolId       Int
  sectionId      Int
  academicYearId Int

  subject      String
  title        String
  description  String?
  assignedDate DateTime
  dueDate      DateTime?
  status       String    @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       school       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section      section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicyear academicyear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([schoolId, sectionId, academicYearId])
  @@index([sectionId, academicYearId, assignedDate])
  @@index([academicYearId])
}

model schoolsubject {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  name      String
  code      String?
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school        school         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSubjects classsubject[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model classsubject {
  id        Int      @id @default(autoincrement())
  classId   Int
  subjectId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicclass         academicclass          @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject               schoolsubject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  syllabi               syllabus[]
  examdatesheetsubjects examdatesheetsubject[]
  resultSubjects resultsubject[]

  @@unique([classId, subjectId])
  @@index([subjectId])
}

model syllabus {
  id             Int      @id @default(autoincrement())
  classSubjectId Int
  academicYearId Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  classSubject     classsubject      @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  academicYear     academicyear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  units            syllabusunit[]
  syllabuschapters syllabuschapter[]

  @@unique([classSubjectId, academicYearId])
  @@index([academicYearId])
}

model syllabusunit {
  id         Int      @id @default(autoincrement())
  syllabusId Int
  title      String
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  syllabus syllabus          @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  chapters syllabuschapter[]

  @@index([syllabusId, position])
}

model syllabuschapter {
  id         Int      @id @default(autoincrement())
  unitId     Int?
  syllabusId Int
  title      String
  position   Int      @default(0)
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  unit     syllabusunit?   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  syllabus syllabus        @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  topics   syllabustopic[]

  @@index([syllabusId, position])
  @@index([unitId, position])
  @@index([status])
}

model syllabustopic {
  id        Int      @id @default(autoincrement())
  chapterId Int
  title     String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapter syllabuschapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId, position])
}

model examdatesheet {
  id             Int                 @id @default(autoincrement())
  schoolId       Int
  academicYearId Int
  classId        Int
  examName       String
  creationType   ExamDateSheetType
  pdfUrl         String?
  status         ExamDateSheetStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  school        school                 @relation(fields: [schoolId], references: [id])
  academicyear  academicyear           @relation(fields: [academicYearId], references: [id])
  academicclass academicclass          @relation(fields: [classId], references: [id])
  subjects      examdatesheetsubject[]

  @@unique([schoolId, academicYearId, classId, examName])
  @@index([schoolId, academicYearId, classId, status])
}

model examdatesheetsubject {
  id             Int      @id @default(autoincrement())
  dateSheetId    Int
  classSubjectId Int
  examDate       DateTime @db.Date
  startTime      String
  endTime        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  dateSheet    examdatesheet @relation(fields: [dateSheetId], references: [id], onDelete: Cascade)
  classSubject classsubject  @relation(fields: [classSubjectId], references: [id])

  @@unique([dateSheetId, classSubjectId])
  @@index([dateSheetId, examDate])
}

model result {
  id             Int          @id @default(autoincrement())
  schoolId       Int
  studentId      Int
  academicYearId Int
  classId        Int
  sectionId      Int
  term           ResultTerm
  totalObtained  Decimal      @default(0) @db.Decimal(8, 2)
  totalMaximum   Decimal      @default(0) @db.Decimal(8, 2)
  percentage     Decimal      @default(0) @db.Decimal(6, 2)
  gpa            Decimal?     @db.Decimal(4, 2)
  status         ResultStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  school        school        @relation(fields: [schoolId], references: [id])
  student       student       @relation(fields: [studentId], references: [id])
  academicyear  academicyear  @relation(fields: [academicYearId], references: [id])
  academicclass academicclass @relation(fields: [classId], references: [id])
  section       section       @relation(fields: [sectionId], references: [id])
  subjects      resultsubject[]

  @@unique([studentId, academicYearId, term])
  @@index([schoolId, academicYearId, classId, sectionId, term])
  @@index([studentId, academicYearId])
}

model resultsubject {
  id             Int      @id @default(autoincrement())
  resultId       Int
  classSubjectId Int

  totalMarks     Decimal  @default(0) @db.Decimal(8, 2)
  maximumMarks   Decimal  @default(0) @db.Decimal(8, 2)
  percentage     Decimal  @default(0) @db.Decimal(6, 2)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  result         result       @relation(fields: [resultId], references: [id], onDelete: Cascade)
  classSubject   classsubject @relation(fields: [classSubjectId], references: [id])
  componentMarks resultcomponentmarks[]

  @@unique([resultId, classSubjectId])
  @@index([classSubjectId])
}
model resultcomponentconfig {
  id             Int        @id @default(autoincrement())
  schoolId       Int
  academicYearId Int
  classId        Int
  term           ResultTerm

  code           String
  name           String
  maximumMarks   Decimal    @db.Decimal(6, 2)
  displayOrder   Int        @default(0)
  isActive       Boolean    @default(true)

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  school         school        @relation(fields: [schoolId], references: [id])
  academicyear   academicyear  @relation(fields: [academicYearId], references: [id])
  academicclass  academicclass @relation(fields: [classId], references: [id])

  componentMarks resultcomponentmarks[]

  @@unique([schoolId, academicYearId, classId, term, code])
  @@index([schoolId, academicYearId, classId, term])
}
model resultcomponentmarks {
  id                 Int      @id @default(autoincrement())
  resultSubjectId    Int
  componentConfigId  Int

  componentName      String
  obtainedMarks      Decimal  @db.Decimal(6, 2)
  maximumMarks       Decimal  @db.Decimal(6, 2)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  resultSubject      resultsubject          @relation(fields: [resultSubjectId], references: [id], onDelete: Cascade)
  componentConfig    resultcomponentconfig  @relation(fields: [componentConfigId], references: [id], onDelete: Restrict)

  @@unique([resultSubjectId, componentConfigId])
  @@index([componentConfigId])
}